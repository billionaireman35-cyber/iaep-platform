generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
  INSTRUCTOR
}
enum AppStatus {
  PENDING
  APPROVED
  REJECTED
  AWAITING_PAYMENT
}

model Grade {
  id String @id
  name String
  postNominal String
  description String
  minYears Int
  cpdHours Int
  duesUsd Int @default(0)
  duesNgn Int @default(0)
  users User[]
  applications Application[]
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String
  role Role @default(MEMBER)
  memberNo String? @unique
  postNominal String?
  gradeId String?
  grade Grade? @relation(fields: [gradeId], references: [id])
  disciplineId String?
  title String?
  organization String?
  cpdTarget Int @default(40)
  createdAt DateTime @default(now())
  enrollments Enrollment[]
  registrations Registration[]
  cpd CpdEntry[]
}
model Application {
  id String @id @default(cuid())
  ref String @unique
  name String
  email String
  phone String?
  country String
  city String?
  disciplineId String
  gradeId String
  grade Grade @relation(fields: [gradeId], references: [id])
  degree String
  institution String
  gradYear Int
  employer String
  jobTitle String
  years Int
  summary String?
  sponsorName String?
  sponsorNo String?
  status AppStatus @default(PENDING)
  createdAt DateTime @default(now())
}
model Course {
  id String @id @default(cuid())
  title String
  description String
  level String
  cpdHours Int
  enrollments Enrollment[]
  divisionId String?
  instructorId String?
  instructorName String @default("")
  lessons Lesson[]
  classes LiveClass[]
  threads Thread[]
}
model Enrollment {
  id String @id @default(cuid())
  userId String
  courseId String
  user User @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  @@unique([userId, courseId])
}
model Event {
  id String @id @default(cuid())
  title String
  category String
  date DateTime
  venue String
  speaker String
  cpdHours Int
  registrations Registration[]
}
model Registration {
  id String @id @default(cuid())
  userId String
  eventId String
  user User @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])
  @@unique([userId, eventId])
}
model CpdEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  title String
  provider String
  category String
  hours Int
  date DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  text      String
  createdAt DateTime @default(now())
}

model Page {
  slug      String   @id
  title     String
  body      String   @default("")
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(cuid())
  txRef String @unique
  applicationId String
  amount Int
  currency String
  status String @default("PENDING")
  passwordHash String
  flwId String?
  memberNo String?
  createdAt DateTime @default(now())
}

model Division {
  id String @id
  name String
  summary String
  subfields String[]
}

model Lesson {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title String
  body String @default("")
  videoUrl String @default("")
  position Int @default(0)
  createdAt DateTime @default(now())
}
model LiveClass {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title String
  startsAt DateTime
  durationMins Int @default(60)
  joinUrl String
}
model Thread {
  id String @id @default(cuid())
  courseId String?
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId String?
  title String
  body String
  authorId String
  authorName String
  authorRole String
  authorPost String @default("")
  createdAt DateTime @default(now())
  replies Reply[]
}
model Reply {
  id String @id @default(cuid())
  threadId String
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId String
  authorName String
  authorRole String
  authorPost String @default("")
  body String
  createdAt DateTime @default(now())
}

model LessonProgress {
  id String @id @default(cuid())
  userId String
  lessonId String
  courseId String
  createdAt DateTime @default(now())
  @@unique([userId, lessonId])
}
model Certificate {
  id String @id @default(cuid())
  code String @unique
  userId String
  courseId String
  memberName String
  memberNo String @default("")
  courseTitle String
  hours Int
  instructorName String @default("")
  issuedAt DateTime @default(now())
  @@unique([userId, courseId])
}
